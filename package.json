{
  "name": "slice-tube",
  "version": "1.0.0",
  "description": "YouTube Video Trimmer & Downloader — cut any part of a YouTube video and download it as MP4 / WebM / MP3, plus download subtitles.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "playwright-core": "^1.65.1"
  }
}
